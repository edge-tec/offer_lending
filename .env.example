APP_NAME="FWB Connect"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Database Configuration
# Use 'mysql' in production or 'sqlite' for zero-config portable testing
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fwb_affiliate
DB_USERNAME=root
DB_PASSWORD=

# Session Lifetime (seconds)
SESSION_LIFETIME=7200

